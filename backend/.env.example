
DJANGO_SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
LOG_LEVEL=INFO

# Local URLs (Vite dev server proxies /api to Django)
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_REGISTRATION=True

# Database: sqlite (simple local dev) or mysql (preferred)
DATABASE_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
MYSQL_DATABASE=wa_assistant
MYSQL_USER=wa_assistant
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Background jobs: thread (local dev) | worker (run `manage.py run_jobs`) | sync
JOBS_MODE=thread

# AI provider default for NEW workspaces: gemini | deepseek | groq
# (the dashboard selection, stored per workspace, decides the active provider)
AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq (GroqCloud) - official API with a FREE plan (rate limited). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low

# ElevenLabs (optional; text replies work without it)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=opus_48000_64
ELEVENLABS_TIMEOUT=45

# Meta WhatsApp Business Platform (Cloud API)
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TIMEOUT=20
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# DEV ONLY: accept unsigned webhooks when META_APP_SECRET is empty (requires DEBUG=True)
WHATSAPP_ALLOW_UNSIGNED_WEBHOOKS=False
